!fastrtc-demo/qwen_voice_chat.py
!fastrtc-demo/test_qwen_realtime.py
!fastrtc-demo/livekit_bridge_chat.py

# Pipecat demo（自研）
!pipecat-demo/
!pipecat-demo/demo_local_bailian.py

# TEN demo（自研验证脚本）
